# Local configuration for the MCP server.
# Copy to .env and fill in. .env is gitignored; this template is not.

# REQUIRED for anything beyond local development.
# Generate with: openssl rand -hex 32
#
# Without this the server generates a random secret at start-up and warns on
# stderr. Approval tickets then do not survive a restart. Never commit a real
# secret; never reuse this placeholder outside local development.
MCP_SIGNING_SECRET=

# Default per-session spend ceiling in USD.
MCP_SESSION_BUDGET_USD=5.0

# Log level for the stderr stream.
MCP_LOG_LEVEL=INFO
