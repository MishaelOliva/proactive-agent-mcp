# Build context exclusions.
# Keeps the image small and prevents local state from leaking into it.

.git
.gitignore
.github

# Virtual environments
.venv
venv
env
ENV

# Byte-compiled and caches
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Packaging output
build
dist
*.egg-info
sdist
wheels

# Secrets and local state: never bake these into an image.
.env
.env.*
!.env.example
*.pem
*.key
*.log
logs
state

# Docs and tests are not needed at runtime
tests
CONTRIBUTING.md
SECURITY.md
ISSUE_TEMPLATE
deploy

# Editors and OS cruft
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db
